{
  "name": "s3pdm",
  "version": "1.0.0",
  "description": "Single page website",
  "scripts": {
    "start": "concurrently \"npm run dev:*\"",
    "dev:11ty": "NODE_ENV=dev npx @11ty/eleventy --serve --port=8080",
    "dev:tw": "tailwindcss -i src/assets/css/tailwind.css -o _site/assets/css/tailwind.css --watch",
    "build": "ELEVENTY_PRODUCTION=true npx @11ty/eleventy && NODE_ENV=production npx tailwindcss -i src/assets/css/tailwind.css -c tailwind.config.js -o _site/assets/css/tailwind.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.14"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.1",
    "@tailwindcss/cli": "^4.0.8",
    "@tailwindcss/postcss": "^4.0.7",
    "postcss": "^8.5.2"
  }
}
